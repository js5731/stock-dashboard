# Supabase PostgreSQL 연결 URL
# Supabase 대시보드 > Settings > Database > Connection string > URI 에서 복사
# Transaction mode(포트 6543) 권장
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# SQLite 경로 (SUPABASE_DB_URL 없을 때만 사용, 기본값: data/app.db)
# STOCK_DB=data/app.db

# 시세 제공자: sample(기본, 가짜 시세) | fdr(FinanceDataReader)
# STOCK_PROVIDER=sample

# 키움 REST API (조회 버튼의 현재가 조회용, 주문 기능 없음). 키는 절대 커밋하지 말 것
# 키움 Open API 사이트(openapi.kiwoom.com)에서 앱키를 발급받아 아래 예시 값 대신 입력
KIWOOM_APPKEY=여기에_앱키_입력
KIWOOM_SECRETKEY=여기에_시크릿키_입력
# 실서버(기본): https://api.kiwoom.com / 모의투자: https://mockapi.kiwoom.com
KIWOOM_BASE_URL=https://mockapi.kiwoom.com
